@echo off
chcp 65001 > nul
cd /d "%~dp0"
echo Сброс аккаунта 18+: будут удалены имя, пароль и вход на этом компьютере.
echo Каналы 18+ снова закроются, потом можно зарегистрироваться заново.
set /p A=Продолжить? Введите Y и Enter:
if /i not "%A%"=="Y" goto :eof
del /q "cache\users.json" "cache\sessions.json" 2>nul
echo Готово. Перезапускать программу не нужно: обновите страницу и поставьте галочку 18+.
pause
